# Modelo do .env de PRODUÇÃO. No servidor: cp .env.producao.example .env
# e preencha o que está vazio. Nunca reutilize as senhas de desenvolvimento.

APP_NAME=OrcaMes
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Gere com: docker compose -f docker-compose.producao.yml run --rm app php artisan key:generate --show
APP_KEY=

# Domínio sem "https://". Com um domínio aqui, o HTTPS é emitido sozinho.
# Para testar pelo IP antes de apontar o domínio, use SERVER_NAME=:80,
# APP_URL=http://IP-DO-SERVIDOR e SESSION_SECURE_COOKIE=false.
SERVER_NAME=
APP_URL=https://
SESSION_SECURE_COOKIE=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Lidos também pelo docker-compose.producao.yml para criar o banco na primeira subida.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=orcames
DB_USERNAME=orcames
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
