APP_NAME=OrcaMes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Os valores abaixo são lidos também pelo docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=orcames
DB_USERNAME=orcames
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
